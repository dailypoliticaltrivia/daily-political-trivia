# Keeps two free-tier things from going to sleep. It stores no passwords: it uses your PUBLIC Supabase
# address and public (anon / publishable) key, saved as repository settings (see DEPLOY.md, step 12).
#   1. Supabase pauses FREE projects that have no activity for 7 days. This pings the database twice a week.
#   2. GitHub turns off scheduled workflows in a PUBLIC repository after 60 days without repository activity.
#      Once a month this job commits one tiny line to .github/keepalive.txt so the news refresh keeps running.
# If the repository settings are not filled in yet, this job just says so and finishes successfully.
name: Keep alive

on:
  schedule:
    - cron: "23 5 * * 1,4"      # Monday and Thursday, 05:23 UTC
  workflow_dispatch:

permissions:
  contents: read          # least privilege; only the heartbeat job below is allowed to write

jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Ping Supabase
        env:
          SUPABASE_URL: ${{ vars.SUPABASE_URL }}
          SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
        run: |
          if [ -z "$SUPABASE_URL" ] || [ -z "$SUPABASE_ANON_KEY" ]; then
            echo "Supabase is not set up yet (variable SUPABASE_URL / secret SUPABASE_ANON_KEY missing). Nothing to ping."
            exit 0
          fi
          url="${SUPABASE_URL%/}/rest/v1/posts?select=id&limit=1"
          if [[ "$SUPABASE_ANON_KEY" == eyJ* ]]; then
            code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 30 "$url" -H "apikey: $SUPABASE_ANON_KEY" -H "Authorization: Bearer $SUPABASE_ANON_KEY")
          else
            code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 30 "$url" -H "apikey: $SUPABASE_ANON_KEY")
          fi
          echo "Supabase answered HTTP $code"
          case "$code" in
            2??) echo "OK: database is awake." ;;
            *) echo "::error::Supabase did not answer normally (HTTP $code). Open the Supabase dashboard: the project may be paused (click Restore)."; exit 1 ;;
          esac

  repo-activity:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683  # v4.2.2 (pinned to a commit)
      - name: Monthly heartbeat commit
        run: |
          if [ "$(date -u +%d)" -gt 7 ] && [ "${{ github.event_name }}" = "schedule" ]; then
            echo "Not the first week of the month; no heartbeat needed."; exit 0
          fi
          date -u +"last keepalive: %Y-%m-%d" > .github/keepalive.txt
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .github/keepalive.txt
          git commit -m "chore: keepalive heartbeat" || { echo "nothing to commit"; exit 0; }
          git push || (git pull --rebase && git push)
