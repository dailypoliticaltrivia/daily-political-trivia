0/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":9},"c050":{"why":"unexplained","kind":"other","text":"Iowa's district lines were redrawn between censuses, first used in the 1886 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":9},"c073":{"why":"census","kind":"census","text":"New map drawn after the 1930 census, which cut Iowa's seats from 11 to 9. It was first used in the 1932 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":11},"c078":{"why":"census","kind":"census","text":"New map drawn after the 1940 census, which cut Iowa's seats from 9 to 8. It was first used in the 1942 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":9},"c088":{"why":"census","kind":"census","text":"New map drawn after the 1960 census, which cut Iowa's seats from 8 to 7. It was first used in the 1962 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":7},"c093":{"why":"census","kind":"census","text":"New map drawn after the 1970 census, which cut Iowa's seats from 7 to 6. It was first used in the 1972 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":7},"c098":{"why":"census","kind":"census","text":"New map drawn after the 1980 census, which left Iowa with 6 seats. It was first used in the 1982 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":6},"c103":{"why":"census","kind":"census","text":"New map drawn after the 1990 census, which cut Iowa's seats from 6 to 5. It was first used in the 1992 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":6},"c108":{"why":"census","kind":"census","text":"New map drawn after the 2000 census, which left Iowa with 5 seats. It was first used in the 2002 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":5},"c113":{"why":"event","kind":"other","text":"New map following: First staff plan approved for four seats. With Iowa dropping from five seats to four, the legislature approved the first congressional plan drafted by the Legislative Services Agency on April 18, 2011. The governor signed it April 29.","sources":["https://redistricting.lls.edu/state/iowa/"],"districtsChanged":5},"c118":{"why":"event","kind":"other","text":"New map following: Second staff plan approved. The legislature rejected the Legislative Services Agency's first proposed plan on October 5, 2021, then approved its second proposal on October 28. The governor signed it November 4.","sources":["https://redistricting.lls.edu/state/iowa/"],"districtsChanged":4}}}