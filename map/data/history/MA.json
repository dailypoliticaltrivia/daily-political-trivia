ionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":12},"c098":{"why":"census","kind":"census","text":"New map drawn after the 1980 census, which cut Massachusetts's seats from 12 to 11. It was first used in the 1982 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":12},"c103":{"why":"census","kind":"census","text":"New map drawn after the 1990 census, which cut Massachusetts's seats from 11 to 10. It was first used in the 1992 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":11},"c108":{"why":"event","kind":"other","text":"New map following: Map becomes law without signature. The legislature passed a 10-district plan on January 31, 2002, after rejecting a proposal from the governor. It became law on February 11, 2002, without the governor's signature.","sources":["https://redistricting.lls.edu/state/massachusetts/"],"districtsChanged":10},"c113":{"why":"event","kind":"other","text":"New map following: Map redrawn for nine seats. With Massachusetts dropping from ten seats to nine, the legislature passed a new map on November 16, 2011, and the governor signed it November 21. No court challenge appears to have been filed.","sources":["https://redistricting.lls.edu/state/massachusetts/"],"districtsChanged":10},"c115":{"why":"unexplained","kind":"other","text":"Massachusetts's district lines were redrawn between censuses, first used in the 2016 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":5},"c118":{"why":"event","kind":"other","text":"New map following: Current map enacted. The legislature passed a new nine-district map on November 17, 2021, and the governor signed it November 22, effective immediately.","sources":["https://redistricting.lls.edu/state/massachusetts/"],"districtsChanged":9}}}