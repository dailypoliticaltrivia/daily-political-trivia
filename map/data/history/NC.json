20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":10},"c008":{"why":"census","kind":"census","text":"New map drawn after the 1800 census, which raised North Carolina's seats from 10 to 12. It was first used in the 1802 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":12},"c013":{"why":"census","kind":"census","text":"New map drawn after the 1810 census, which raised North Carolina's seats from 12 to 13. It was first used in the 1812 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":8},"c028":{"why":"census","kind":"census","text":"New map drawn after the 1840 census, which cut North Carolina's seats from 13 to 9. It was first used in the 1842 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":13},"c030":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 1846 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":8},"c033":{"why":"census","kind":"census","text":"New map drawn after the 1850 census, which cut North Carolina's seats from 9 to 8. It was first used in the 1852 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":9},"c037":{"why":"at-large","kind":"other","text":"North Carolina sent no members to the 37th Congress (1861–1863), so the map shows only its outline and no districts.","sources":["https://github.com/unitedstates/congress-legislators","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":0},"c039":{"why":"at-large","kind":"other","text":"From the 39th Congress the historical boundary records again show districts for North Carolina, after Congresses in which it sent no members.","sources":["https://github.com/unitedstates/congress-legislators","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":0},"c040":{"why":"researched","kind":"other","text":"North Carolina's 1868 constitutional convention, called under the federal Reconstruction Acts, approved a committee plan redrawing the state's seven congressional districts for the 1868 elections.","sources":["https://www.ednc.org/day-33-of-the-convention/","https://www.ednc.org/day-54-of-the-convention/"],"districtsChanged":7},"c043":{"why":"census","kind":"census","text":"New map drawn after the 1870 census, which raised North Carolina's seats from 7 to 8. It was first used in the 1872 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":8},"c048":{"why":"at-large","kind":"at-large","text":"After the 1880 census raised North Carolina's seats from 8 to 9, the state kept its existing districts and elected one member statewide (at-large).","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://github.com/unitedstates/congress-legislators"],"districtsChanged":0},"c049":{"why":"researched","kind":"census","text":"In 1882 North Carolina elected its new ninth seat statewide (at-large). For the 1884 election the seat was folded into a new set of nine districts.","sources":["https://en.wikipedia.org/wiki/North_Carolina%27s_at-large_congressional_seat","https://github.com/unitedstates/congress-legislators"],"secondary":true,"districtsChanged":9},"c053":{"why":"census","kind":"census","text":"New map drawn after the 1890 census, which left North Carolina with 9 seats. It was first used in the 1892 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":9},"c055":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 1896 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":2},"c056":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 1898 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":2},"c057":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 1900 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":3},"c058":{"why":"census","kind":"census","text":"New map drawn after the 1900 census, which raised North Carolina's seats from 9 to 10. It was first used in the 1902 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":10},"c061":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 1908 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":4},"c063":{"why":"census","kind":"census","text":"New map drawn after the 1910 census, which left North Carolina with 10 seats. It was first used in the 1912 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":6},"c073":{"why":"census","kind":"census","text":"New map drawn after the 1930 census, which raised North Carolina's seats from 10 to 11. It was first used in the 1932 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":8},"c078":{"why":"census","kind":"census","text":"New map drawn after the 1940 census, which raised North Carolina's seats from 11 to 12. It was first used in the 1942 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":3},"c088":{"why":"census","kind":"census","text":"New map drawn after the 1960 census, which cut North Carolina's seats from 12 to 11. It was first used in the 1962 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":11},"c090":{"why":"researched","kind":"court","text":"In Drum v. Seawell (1965) a federal court struck down North Carolina's congressional map for unequal populations. The court found the 1966 replacement still fell short but let it be used for the 1966 election.","sources":["https://law.justia.com/cases/federal/district-courts/FSupp/250/922/2341362/"],"districtsChanged":10},"c091":{"why":"researched","kind":"court","text":"Still under the Drum v. Seawell case, the General Assembly passed a new congressional map in July 1967. The federal court found it met constitutional standards and closed the case.","sources":["https://library.ncleg.net/EnactedLegislation/SessionLaws/HTML/1967-1968/SL1967-1109.html","https://www.leagle.com/decision/1967464271fsupp1931433"],"districtsChanged":10},"c093":{"why":"census","kind":"census","text":"New map drawn after the 1970 census, which left North Carolina with 11 seats. It was first used in the 1972 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":11},"c098":{"why":"census","kind":"census","text":"New map drawn after the 1980 census, which left North Carolina with 11 seats. It was first used in the 1982 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":11},"c103":{"why":"census","kind":"census","text":"New map drawn after the 1990 census, which raised North Carolina's seats from 11 to 12. It was first used in the 1992 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":12},"c106":{"why":"event","kind":"court","text":"New map following: Shaw v. Hunt. The Supreme Court held that the 12th District was a racial gerrymander not justified by the Voting Rights Act. The legislature redrew the map in 1997.","sources":["https://www.law.cornell.edu/supremecourt/text/517/899"],"districtsChanged":12},"c107":{"why":"unexplained","kind":"other","text":"North Carolina's district lines were redrawn between censuses, first used in the 2000 election. The reason has not been researched yet.","sources":["https://cdmaps.polisci.ucla.edu/"],"districtsChanged":5},"c108":{"why":"census","kind":"census","text":"New map drawn after the 2000 census, which raised North Carolina's seats from 12 to 13. It was first used in the 2002 election.","sources":["https://www2.census.gov/decennial/2000/data/apportionment/2000%20PHC3%20Table%203.pdf","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":12},"c113":{"why":"census","kind":"census","text":"New map drawn after the 2010 census, which left North Carolina with 13 seats. It was first used in the 2012 election.","sources":["https://www2.census.gov/programs-surveys/decennial/2020/data/apportionment/apportionment.csv","https://cdmaps.polisci.ucla.edu/"],"districtsChanged":13},"c115":{"why":"event","kind":"court","text":"New map following: Court-ordered redraw. A federal court ruled in February 2016 that the 1st and 12th Districts were racial gerrymanders. The legislature drew a new map that month, used from the 2016 election.","sources":["https://www.law.cornell.edu/supremecourt/text/15-1262","https://redistricting.lls.edu/state/north-carolina/"],"districtsChanged":13},"c117":{"why":"event","kind":"court","text":"New map following: State court leads to a new map. A North Carolina trial court blocked the 2016 map under the state constitution in October 2019. The legislature passed a new map in November 2019, used in the 2020 election.","sources":["https://redistricting.lls.edu/state/north-carolina/"],"districtsChanged":13},"c118":{"why":"event","kind":"court","text":"New map following: Harper v. Hall. The North Carolina Supreme Court struck down the 2021 congressional map as a partisan gerrymander under the state constitution. A court-adopted interim map was used in the 2022 election.","sources":["https://redistricting.lls.edu/state/north-carolina/"],"districtsChanged":14},"c119":{"why":"event","kind":"court","text":"New map following: Harper v. Hall reversed. On rehearing in April 2023, the North Carolina Supreme Court overruled its 2022 decision, holding that partisan gerrymandering claims cannot be decided under the state constitution. The legislature passed a new map in October 2023, used from the 2024 election.","sources":["https://redistricting.lls.edu/state/north-carolina/"],"districtsChanged":14},"c120":{"why":"event","kind":"mid-decade","text":"New map following: Mid-decade redistricting. In October 2025 the General Assembly passed a revised map that moved voters between the 1st and 3rd Districts. A three-judge federal court declined to block it on November 26, 2025, and it was used in the 2026 election.","sources":["https://abc11.com/post/judges-allow-north-carolina-use-map-drawn-bid-give-republicans-another-us-house-seat/18215872/"],"districtsChanged":2}}}